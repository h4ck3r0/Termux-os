#!/usr/bin/env fish

set fish_greeting
set -gx CLICOLOR 1
set -gx CLICOLOR_FORCE 1
set -gx fish_autosuggestion_enabled 1

# Global so print_center and draw_line can access it
set -g BOX_WIDTH 56

function print_center
    set text $argv[1]
    set text_len (string length $text)
    set space_len (math --scale=0 "floor(($BOX_WIDTH - 2 - $text_len) / 2)")
    set right_len (math --scale=0 "$BOX_WIDTH - 2 - $text_len - $space_len")
    printf "\033[0;36m \u2551%*s\033[0m%s\033[0;36m%*s\u2551\033[0m\n" $space_len "" "$text" $right_len ""
end

function draw_line
    set lchar $argv[1]
    set rchar $argv[2]
    printf "\033[0;36m %s" "$lchar"
    for i in (seq 1 (math "$BOX_WIDTH - 2"))
        printf "\u2550"
    end
    printf "%s\033[0m\n" "$rchar"
end

function draw_banner
    clear
    printf "\033[1;32m[*] BOOTING TERMUX-OS v3...\033[0m\n"
    printf "\033[1;36m[LOADING MODULES] \033[1;32m"
    for i in (seq 1 25)
        printf "\u2588"
        sleep 0.02
    end
    printf "\033[0m\n"
    sleep 0.4
    clear

    draw_line \u2554 \u2557
    print_center ""
    printf " \033[1;32m\u2554\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2557\033[0m\n"
    print_center "PROC"
    printf " \033[1;32m\u255a\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u255d\033[0m\n"
    print_center ""
    print_center "SYSTEM: ONLINE  |  USER: H4ck3r"
    print_center "OS : Termux-OS v3 (Fish Shell)"
    print_center "SECURE CONNECTION ESTABLISHED"
    print_center ""
    draw_line \u255a \u255d
end

draw_banner

alias l='exa -la'
alias ls='exa -la'
alias ll='exa -l'
alias cat='bat'

function fish_prompt
    echo
    set_color cyan
    echo -n "\u250c\u2500["
    set_color green
    echo -n "H4ck3r"
    set_color cyan
    echo -n "@"
    set_color yellow
    echo -n (hostname)
    set_color cyan
    echo -n "]\u2500["
    set_color magenta
    echo -n (prompt_pwd)
    set_color cyan
    echo -n "]"
    echo
    echo -n "\u2514\u2500> "
    set_color normal
end

set -gx fish_history max
set -gx fish_color_autosuggestion 555 brblack
set -gx fish_color_selection brcyan
set -gx fish_color_search_match bryellow
