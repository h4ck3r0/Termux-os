#!/usr/bin/env fish

set fish_greeting
set -gx CLICOLOR 1
set -gx CLICOLOR_FORCE 1

set -g BOX_WIDTH 56

function print_center
    set text $argv[1]
    set text_len (string length $text)
    set space_len (math --scale=0 "floor(($BOX_WIDTH - 2 - $text_len) / 2)")
    set right_len (math --scale=0 "$BOX_WIDTH - 2 - $text_len - $space_len")
    printf "\033[0;36m \u2551%*s\033[0m%s\033[0;36m%*s\u2551\033[0m\n" $space_len "" "$text" $right_len ""
end

function draw_line
    set lchar $argv[1]
    set rchar $argv[2]
    printf "\033[0;36m %s" "$lchar"
    for i in (seq 1 (math "$BOX_WIDTH - 2"))
        printf "\u2550"
    end
    printf "%s\033[0m\n" "$rchar"
end

function draw_banner
    clear
    draw_line \u2554 \u2557
    print_center ""
    figlet -c -f ASCII-Shadow -w $BOX_WIDTH "h4ck3r0" 2>/dev/null | lolcat 2>/dev/null; or printf "\033[1;35m  h4ck3r0\033[0m\n"
    print_center ""
    print_center "SYSTEM: ONLINE  |  USER: ROOT"
    print_center "OS : Termux-OS v3 (Fish Shell)"
    print_center "SECURE CONNECTION ESTABLISHED"
    print_center ""
    draw_line \u255a \u255d
end

draw_banner

alias l='exa -la'
alias ls='exa -la'
alias cat='bat'
alias ll='exa -l'

function fish_prompt
    echo
    set_color cyan
    echo -n "\u250c\u2500["
    set_color green
    echo -n (whoami)
    set_color cyan
    echo -n "@"
    set_color yellow
    echo -n (hostname)
    set_color cyan
    echo -n "]\u2500["
    set_color magenta
    echo -n (prompt_pwd)
    set_color cyan
    echo -n "]"
    echo
    echo -n "\u2514\u2500> "
    set_color normal
end

set -gx fish_history max
